generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/inner_momentum_manager/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Post {
  id              String    @id @default(cuid())
  title           String
  pillar          String
  type            String    @default("REEL")
  script          String?   @db.Text
  caption         String?   @db.Text
  hashtags        String?   @db.Text
  cta             String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  status          String    @default("DRAFT")
  videoUrl        String?
  instagramPostId String?
  assetId         String?
  asset           Asset?    @relation(fields: [assetId], references: [id])
  logs            ActivityLog[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([pillar])
  @@index([assetId])
}

model InstagramAccount {
  id           String   @id @default(cuid())
  igUserId     String?
  accessToken  String?  @db.Text
  tokenExpiry  DateTime?
  username     String?
  isConnected  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String?  @db.Text
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([createdAt])
}

model Settings {
  id              String  @id @default(cuid())
  publicationMode String  @default("DRAFT")
  postsPerWeek    Int     @default(5)
  preferredDays   String  @default("1,2,3,4,5")
  preferredTimes  String  @default("09:00,12:00,18:00")
  globalPause     Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Asset {
  id               String   @id @default(cuid())
  fileName         String
  fileType         String
  fileSize         Int
  cloudStoragePath String
  isPublic         Boolean  @default(false)
  duration         Float?
  width            Int?
  height           Int?
  posts            Post[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
